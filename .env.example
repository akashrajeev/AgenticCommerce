NODE_ENV=development

# Local services
DATABASE_URL=postgresql://mandate:mandate@localhost:5432/mandate?schema=public
BUYER_APP_ORIGIN=http://localhost:3001
MERCHANT_APP_ORIGIN=http://localhost:3000
INTERNAL_GATEWAY_SECRET=mandate-local-gateway
MCP_AGENT_TOKEN=mandate-local-mcp
ACP_API_KEY=mandate-local-acp

# Razorpay Test Mode only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional merchant-agent signing identity
# Production requires a persistent Ed25519 PKCS#8 private key.
MERCHANT_AGENT_PRIVATE_KEY_PEM=
MERCHANT_AGENT_KEY_ID=merchant-agent-ed25519-1

# x402 v2 agent-to-service experiment
# The public x402.org facilitator is intended for testnet/development.
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PAY_TO=
X402_SERVICE_ID=mandate-premium-data
X402_SERVICE_NAME=MANDATE Agent Service
X402_PRICE_ATOMIC=10000
X402_NETWORK=eip155:84532
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_MAX_TIMEOUT_SECONDS=60
# Enable only for the local/judge demo. This endpoint issues a self-signed demo service authorization.
X402_DEMO_MODE=true
