NODE_ENV=development

# Local services
DATABASE_URL=postgresql://mandate:mandate@localhost:5432/mandate?schema=public
BUYER_APP_ORIGIN=http://localhost:3001
MERCHANT_APP_ORIGIN=http://localhost:3000
INTERNAL_GATEWAY_SECRET=mandate-local-gateway
MCP_AGENT_TOKEN=mandate-local-mcp
ACP_API_KEY=mandate-local-acp

# Razorpay Test Mode only
RAZORPAY_KEY_ID=
