generator client {
  provider            = "prisma-client"
  output              = "../apps/gateway/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id                   String        @id
  state                String
  intent               Json
  quote                Json
  policy               Json?
  mandateAuthorization Json?         @map("mandate_authorization")
  razorpayOrderId      String?       @unique @map("razorpay_order_id")
  razorpayPaymentId    String?       @map("razorpay_payment_id")
  createdAt            DateTime      @map("created_at")
  updatedAt            DateTime      @map("updated_at")
  auditEvents          AuditEvent[]

  @@map("transactions")
}

model AuditEvent {
  id            String      @id
  transactionId String      @map("transaction_id")
  actor         String
  action        String
  reason        String
  metadata      Json?
  createdAt     DateTime    @map("created_at")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt])
  @@map("audit_events")
}

model WebhookEvent {
  dedupeKey         String   @id @map("dedupe_key")
  eventName         String   @map("event_name")
  razorpayOrderId   String?  @map("razorpay_order_id")
  razorpayPaymentId String?  @map("razorpay_payment_id")
  receivedAt        DateTime @map("received_at")

  @@map("webhook_events")
}

model NegotiationSession {
  negotiationId     String   @id @map("negotiation_id")
  intent            Json
  merchant          Json
  offers            Json
  offerAttestations Json?    @map("offer_attestations")
  turns             Json
  createdAt         DateTime @map("created_at")
  expiresAt         DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("negotiation_sessions")
}

model NegotiationAcceptanceClaim {
  key           String   @id
  negotiationId String   @map("negotiation_id")
  mandateId     String   @map("mandate_id")
  offerId       String   @map("offer_id")
  createdAt     DateTime @map("created_at")

  @@index([createdAt])
  @@map("negotiation_acceptance_claims")
}

model NegotiationAcceptance {
  key             String   @id
  negotiationId   String   @map("negotiation_id")
  mandateId       String   @map("mandate_id")
  offer           Json
  transactionId   String   @unique @map("transaction_id")
  executionId     String   @map("execution_id")
  authorizationId String   @map("authorization_id")
  createdAt       DateTime @map("created_at")

  @@index([negotiationId, mandateId])
  @@map("negotiation_acceptances")
}

model CampaignPaymentEvidence {
  evidenceId      String   @id @map("evidence_id")
  campaignId      String   @map("campaign_id")
  transactionId   String   @unique @map("transaction_id")
  razorpayOrderId String   @map("razorpay_order_id")
  razorpayPaymentId String @map("razorpay_payment_id")
  amountPaise     BigInt   @map("amount_paise")
  currency        String
  orderNotes      Json?
  verifiedAt      DateTime @map("verified_at")

  @@index([campaignId, verifiedAt])
  @@map("campaign_payment_evidence")
}
