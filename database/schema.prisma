generator client {
  provider            = "prisma-client"
  output              = "../apps/gateway/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id                   String        @id
  state                String
  intent               Json
  quote                Json
  policy               Json?
  mandateAuthorization Json?         @map("mandate_authorization")
  razorpayOrderId      String?       @unique @map("razorpay_order_id")
  razorpayPaymentId    String?       @map("razorpay_payment_id")
  createdAt            DateTime      @map("created_at")
  updatedAt            DateTime      @map("updated_at")
  auditEvents          AuditEvent[]

  @@map("transactions")
}

model AuditEvent {
  id            String      @id
  transactionId String      @map("transaction_id")
  actor         String
  action        String
  reason        String
  metadata      Json?
  createdAt     DateTime    @map("created_at")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt])
  @@map("audit_events")
}

model WebhookEvent {
  dedupeKey         String   @id @map("dedupe_key")
  eventName         String   @map("event_name")
  razorpayOrderId   String?  @map("razorpay_order_id")
  razorpayPaymentId String?  @map("razorpay_payment_id")
  receivedAt        DateTime @map("received_at")

  @@map("webhook_events")
}

model NegotiationAcceptance {
  key             String   @id
  negotiationId   String   @map("negotiation_id")
  mandateId       String   @map("mandate_id")
  offer           Json
  transactionId   String   @unique @map("transaction_id")
  executionId     String   @map("execution_id")
  authorizationId String   @map("authorization_id")
  createdAt       DateTime @map("created_at")

  @@index([negotiationId, mandateId])
  @@map("negotiation_acceptances")
}
